# Build settings for `docker compose build` (copy to .env next to docker-compose.yml).
# These are compiled into the web app's browser code, so rebuild the web image after changing them.
# Server secrets do not go here: they live in backend/.env.

# Public address of the API, including /api/v1
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
# Cloudflare Turnstile site key (public). Blank = no captcha widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Tag Manager container id (public), carries Google Analytics. Leave the line out to use Relive's
# container (GTM-WSP875VS); set it blank to build without tracking.
# NEXT_PUBLIC_GTM_ID=GTM-WSP875VS

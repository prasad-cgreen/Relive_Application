NODE_ENV=development
PORT=4100
# Address the API listens on. Docker sets 0.0.0.0; leave unset locally (127.0.0.1).
HOST=
# Web app address(es) allowed to call the API, comma-separated. In production, your real site, e.g. https://relive.in
FRONTEND_ORIGIN=
DATABASE_URL=postgresql://pooled-application-url
DATABASE_URL_UNPOOLED=postgresql://direct-migration-url
AUDIT_DATABASE_URL=postgresql://pooled-audit-application-url/relive_audit
AUDIT_DATABASE_URL_UNPOOLED=postgresql://direct-audit-migration-url/relive_audit

# Long random values (openssl rand -base64 32). Required in production.
SESSION_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret
# Encrypts stored mobile numbers. Changing it makes stored numbers unreadable (users re-save on next login).
DATA_ENCRYPTION_KEY=replace-with-a-third-long-random-secret

# Per service: mock = local fakes (OTP is OTP_MOCK_CODE), indiconnect = real, billed API calls.
# OTP_PROVIDER also accepts smartping (real SMS via Smartping SPARC; needs SMARTPING_* below).
OTP_PROVIDER=mock
PAN_PROVIDER=mock
BUREAU_PROVIDER=mock
OTP_MOCK_CODE=123456
# Smartping SPARC SMS account: user ID (ends in .trans) and its Secret Key
SMARTPING_USERNAME=
SMARTPING_PASSWORD=

INDICONNECT_BASE_URL=https://api.staging.indiconnect.in
INDICONNECT_SERVICE_KEY=
INDICONNECT_AUTHORIZATION=x-api-access indc_test_xxx:ac_test_xxx
INDICONNECT_APP_ID=verification_v1
INDICONNECT_PROVIDER_CODE=
INDICONNECT_TIMEOUT_MS=30000
INDICONNECT_BUREAU_TIMEOUT_MS=60000

# "Get help" leads are emailed to LEADS_EMAIL. Leave SMTP_URL blank to skip emails (leads are still saved in the database).
# Example: smtps://relive%40cgreen.in:APP_PASSWORD@smtp.gmail.com:465 (the @ in the username must be written as %40)
LEADS_EMAIL=relive@cgreen.in
SMTP_URL=

# Cloudflare Turnstile secret: blocks bots from triggering billed OTP SMS. Required in production; blank = no check.
# The matching public site key goes in frontend/.env.local as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Shared password for the agents admin page (12+ characters in production), /admin/agents. Blank = admin page switched off.
# Changing it signs everyone out of the admin page.
ADMIN_PASSWORD=

# OpenAI key for the personalised dashboard summary (prompt: prompts/dashboard-summary.md). Blank = rule-based summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

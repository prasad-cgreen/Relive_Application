generator client {
  provider = "prisma-client"
  output   = "../../src/generated/production"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ProfileSource {
  NSDL
  MANUAL_UNVERIFIED
}

enum ConsentPurpose {
  LOGIN
  CREDIT_REPORT
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum OtpChannel {
  SMS
  CALL
  WHATSAPP
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  BLOCKED
  USED
}

enum KycStatus {
  PENDING
  VERIFIED
  FAILED
  MANUAL_REVIEW
}

enum ReportStatus {
  CURRENT
  EXPIRED
  NO_RECORD
  FAILED
}

enum TransactionStatus {
  SUCCESS
  BUSINESS_FAILURE
  TECHNICAL_FAILURE
  TIMEOUT
}

model AppStatus {
  id            String   @id
  schemaVersion Int      @map("schema_version")
  environment   String
  deployedAt    DateTime @default(now()) @map("deployed_at") @db.Timestamptz(6)
  @@map("app_status")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  mobileHash      String   @unique @map("mobile_hash")
  mobileLast4     String   @map("mobile_last4")
  status          UserStatus @default(ACTIVE)
  failedOtpWindow Int      @default(0) @map("failed_otp_window")
  blockedUntil    DateTime? @map("blocked_until")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  profile         UserProfile?
  consents        UserConsent[]
  otps            OtpTransaction[]
  sessions        UserSession[]
  kycs            KycVerification[]
  reports         CreditReport[]
  transactions    ApiTransaction[]
  @@map("users")
}

model UserProfile {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @map("user_id") @db.Uuid
  firstName   String @map("first_name")
  lastName    String @map("last_name")
  email       String
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  source      ProfileSource
  verified    Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
}

model UserConsent {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  purpose     ConsentPurpose
  version     String
  status      ConsentStatus @default(GRANTED)
  grantedAt   DateTime @default(now()) @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, grantedAt])
  @@map("user_consents")
}

model OtpTransaction {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  channel        OtpChannel
  otpHash        String @map("otp_hash")
  status         OtpStatus @default(PENDING)
  failedAttempts Int @default(0) @map("failed_attempts")
  expiresAt      DateTime @map("expires_at")
  resendAfter    DateTime @map("resend_after")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("otp_transactions")
}

model UserSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model KycVerification {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  panHash       String @map("pan_hash")
  panLast4      String @map("pan_last4")
  status        KycStatus
  attempts      Int @default(1)
  providerRef   String? @map("provider_ref")
  failureReason String? @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  verifiedAt    DateTime? @map("verified_at")
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("kyc_verifications")
}

model CreditReport {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  bureau         String @default("EXPERIAN")
  score          Int
  reportJson     Json @map("report_json")
  status         ReportStatus @default(CURRENT)
  providerRef    String? @map("provider_ref")
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  retrievedAt    DateTime @default(now()) @map("retrieved_at")
  expiresAt      DateTime @map("expires_at")
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, expiresAt])
  @@map("credit_reports")
}

model ApiTransaction {
  id             String @id @default(uuid()) @db.Uuid
  userId         String? @map("user_id") @db.Uuid
  provider       String
  operation      String
  status         TransactionStatus
  attempt        Int @default(1)
  idempotencyKey String? @map("idempotency_key")
  errorCode      String? @map("error_code")
  durationMs     Int @map("duration_ms")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([provider, operation, createdAt])
  @@map("api_transactions")
}

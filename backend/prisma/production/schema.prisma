generator client {
  provider = "prisma-client"
  output   = "../../src/generated/production"
}

datasource db {
  provider = "postgresql"
}

// All timestamps are timestamptz (UTC instants), so tools like the Neon console show the zone.

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ProfileSource {
  NSDL
  MANUAL_UNVERIFIED
}

enum ConsentPurpose {
  LOGIN
  CREDIT_REPORT
  MARKETING
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum OtpPurpose {
  LOGIN
  BUREAU_MOBILE // OTP to an alternate number the bureaus may have on file
}

enum OtpStatus {
  PENDING
  USED
  EXPIRED
  BLOCKED
}

enum KycStatus {
  VERIFIED
  FAILED
  MANUAL_REVIEW
}

/// Expiry is not a status: a CURRENT report past expires_at is expired.
enum ReportStatus {
  CURRENT
  NO_RECORD
}

enum TransactionStatus {
  SUCCESS
  BUSINESS_FAILURE
  TECHNICAL_FAILURE
  TIMEOUT
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  mobileHash      String   @unique @map("mobile_hash")
  mobileLast4     String   @map("mobile_last4")
  mobileEncrypted String?  @map("mobile_encrypted") // AES-256-GCM; bureau APIs need the raw number
  bureauMobileEncrypted String? @map("bureau_mobile_encrypted") // OTP-verified alternate number used for bureau pulls
  bureauMobileLast4     String? @map("bureau_mobile_last4")
  status          UserStatus @default(ACTIVE)
  failedOtpWindow Int      @default(0) @map("failed_otp_window")
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile         UserProfile?
  consents        UserConsent[]
  otps            OtpTransaction[]
  sessions        UserSession[]
  kycs            KycVerification[]
  reports         CreditReport[]
  transactions    ApiTransaction[]
  supportRequests SupportRequest[]
  @@map("users")
}

model UserProfile {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @map("user_id") @db.Uuid
  firstName   String @map("first_name")
  lastName    String @map("last_name")
  email       String
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  source      ProfileSource
  verified    Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
}

/// Kept per purpose with status/withdrawn_at so a consent can be withdrawn later (DPDP).
model UserConsent {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  purpose     ConsentPurpose
  version     String
  status      ConsentStatus @default(GRANTED)
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, grantedAt])
  @@map("user_consents")
}

/// One OTP sent by SMS. Wrong attempts are counted per user (users.failed_otp_window), not per OTP.
model OtpTransaction {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  otpHash        String? @map("otp_hash")
  providerRef    String? @map("provider_ref")
  purpose        OtpPurpose @default(LOGIN)
  targetMobileEncrypted String? @map("target_mobile_encrypted") // set for BUREAU_MOBILE
  status         OtpStatus @default(PENDING)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  resendAfter    DateTime @map("resend_after") @db.Timestamptz(3)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("otp_transactions")
}

model UserSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("user_sessions")
}

/// One row per PAN lookup (attempts per day = rows per day).
model KycVerification {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  panHash       String @map("pan_hash")
  panLast4      String @map("pan_last4")
  panEncrypted  String? @map("pan_encrypted") // AES-256-GCM, VERIFIED rows only: bureau pulls send the verified PAN
  status        KycStatus
  providerRef   String? @map("provider_ref")
  failureReason String? @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("kyc_verifications")
}

model CreditReport {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  bureau         String @default("EXPERIAN") // EXPERIAN | CRIF | NONE (no record)
  score          Int
  reportJson     Json @map("report_json")
  rawResponse    Json? @map("raw_response") // full bureau payload, never sent to the browser
  status         ReportStatus @default(CURRENT)
  providerRef    String? @map("provider_ref")
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  retrievedAt    DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, expiresAt])
  @@map("credit_reports")
}

/// Every external provider call (OTP, PAN, bureau): the billing and outage record.
model ApiTransaction {
  id             String @id @default(uuid()) @db.Uuid
  userId         String? @map("user_id") @db.Uuid
  provider       String
  operation      String
  status         TransactionStatus
  attempt        Int @default(1)
  idempotencyKey String? @map("idempotency_key")
  errorCode      String? @map("error_code")
  durationMs     Int @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([provider, operation, createdAt])
  @@map("api_transactions")
}

enum SupportTopic {
  OPTIONS
  LENDER_DISCUSSION
  NOTICE
}

enum SupportStatus {
  NEW
  CONTACTED
  CLOSED
}

/// A "Get help" request from the dashboard: a lead for the Relive team to call back.
/// The contact number is the user's verified mobile (users.mobile_encrypted).
model SupportRequest {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  topic             SupportTopic
  accountLabel      String?       @map("account_label") // lender + masked number, e.g. "ICICI Bank · •••• 5295"; null = overall situation
  question          String
  preferredTime     String        @map("preferred_time")
  preferredLanguage String        @map("preferred_language")
  status            SupportStatus @default(NEW)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@map("support_requests")
}

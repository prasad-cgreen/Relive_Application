# Keep the build context small and secrets out of images.
**/node_modules
**/dist
.git
**/.env
**/.env.*
!**/.env.example
**/.dev.vars*
**/*.pem
**/*.log
**/coverage
**/*.tsbuildinfo

# Generated or local-only state (rebuilt inside the image)
backend/src/generated
frontend/.next
frontend/.vinext
frontend/.wrangler
frontend/.sites-runtime

# Not needed to build or run the app
docs
*.html
*.svg
README.md
Dockerfile
docker-compose.yml
.dockerignore
